# ---- Where recordings land (your Google Drive for desktop folder) ----
# Mac example:     ~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/Idea Inbox
# Windows example: G:\My Drive\Idea Inbox
INBOX_DIR=~/IdeaInbox
# Optional: move processed files here. Leave blank to keep them in place.
ARCHIVE_DIR=
SETTLE_SECONDS=20
POLL_SECONDS=60

# ---- Transcription: local | groq | openai ----
# local  = private and free, slower on a laptop CPU
# groq   = fast and strong on Indian accents; audio is sent to Groq
TRANSCRIBE_BACKEND=local
WHISPER_MODEL=medium          # tiny | base | small | medium | large-v3
WHISPER_LANGUAGE=en           # blank = auto-detect (may output Devanagari for Hindi-heavy notes)
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- Idea extraction ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Notion ----
# Create an internal integration at notion.so/profile/integrations, copy its secret here,
# then share the parent page with it (page ••• > Connections).
NOTION_TOKEN=
# The id at the end of the parent page's URL (32 characters)
NOTION_PARENT_PAGE_ID=

DRY_RUN=false
